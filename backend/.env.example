APP_ENV=development
FRONTEND_URL=http://localhost:3000
# SQLite works out of the box. For Postgres (docker compose up -d):
# DATABASE_URL=postgresql+psycopg://paypilot:paypilot_local_only@localhost:5432/paypilot
DATABASE_URL=sqlite:///./paypilot.db
JWT_SECRET=change-me-to-a-long-random-string
# PayPal SANDBOX REST app (developer.paypal.com > Apps & Credentials). Leave blank to use the labeled demo simulator.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional, faster answers: GEMINI_THINKING_LEVEL=low
